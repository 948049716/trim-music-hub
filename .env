# =================================================================
# TRIM Music Hub - Development Environment Config (.env)
# =================================================================

# 1. 独立开发后端服务端口与主机 (避免与生产容器 4175 冲突)
PORT=3175
HOST=0.0.0.0
NODE_ENV=development

# 2. 飞牛 NAS 本地音乐与官方元数据/数据库路径
MUSIC_DIR=/vol2/1000/媒体/音乐
FNOS_DB_PATH=/usr/local/apps/@appdata/trim.music/db/music.db
FNOS_COVER_DIR=/vol1/@appmeta/trim.music/cover

# 3. 独立持久化数据目录 (避免与 Docker 生产 /vol1/1000/docker/trim-music-hub/data 混淆)
DATA_DIR=/vol1/1000/Project/trim-music-hub/data

# 4. 用户与权限映射
PUID=1000
PGID=1000
DEFAULT_USER=admin
