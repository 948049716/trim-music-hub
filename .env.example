# =================================================================
# TRIM Music Hub 环境配置模板
# 复制此文件为 .env 并按需修改：cp .env.example .env
# =================================================================

# 1. 宿主机音乐文件保存根目录 (必填)
# 例如：/vol1/1000/Music 或 /vol2/1000/媒体/音乐
MUSIC_PATH=/vol1/1000/Music

# 2. 飞牛音乐官方应用数据库目录 (必填，一般飞牛系统结构统一)
FNOS_DB_DIR=/usr/local/apps/@appdata/trim.music/db

# 3. 飞牛音乐官方应用封面缓存目录 (必填，用于复用已刮削封面)
FNOS_COVER_DIR=/vol1/@appmeta/trim.music/cover

# 4. 宿主机访问端口 (默认 4175)
HOST_PORT=4175

# 5. 文件写入所有者权限 (通常飞牛主用户为 1000:1000)
PUID=1000
PGID=1000

# 6. 默认关联的飞牛用户 (通常为您的飞牛登录账号，如 admin 或 948049716)
DEFAULT_USER=admin

# 7. 时区
TZ=Asia/Shanghai
